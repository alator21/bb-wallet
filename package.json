{
  "name": "bb-wallet",
  "version": "0.1.0",
  "description": "TypeScript wrapper for the Budget Bakers Wallet REST API",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/example.ts",
    "typecheck": "bun tsc --noEmit",
    "typecheck:watch": "bun tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target node",
    "check": "bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "effect": "^3.21.0"
  }
}
